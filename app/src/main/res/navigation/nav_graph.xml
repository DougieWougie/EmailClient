<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/inboxFragment">

    <fragment
        android:id="@+id/inboxFragment"
        android:name="com.emailclient.presentation.inbox.InboxFragment"
        android:label="Inbox"
        tools:layout="@layout/fragment_inbox">
        <action
            android:id="@+id/action_inbox_to_detail"
            app:destination="@id/emailDetailFragment" />
        <action
            android:id="@+id/action_inbox_to_compose"
            app:destination="@id/composeFragment" />
    </fragment>

    <fragment
        android:id="@+id/emailDetailFragment"
        android:name="com.emailclient.presentation.detail.EmailDetailFragment"
        android:label="Email"
        tools:layout="@layout/fragment_email_detail">
        <argument
            android:name="emailId"
            app:argType="string" />
        <action
            android:id="@+id/action_detail_to_compose"
            app:destination="@id/composeFragment" />
    </fragment>

    <fragment
        android:id="@+id/composeFragment"
        android:name="com.emailclient.presentation.compose.ComposeFragment"
        android:label="Compose"
        tools:layout="@layout/fragment_compose">
        <argument
            android:name="replyToEmailId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="isReplyAll"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="isForward"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.emailclient.presentation.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_inbox"
            app:destination="@id/inboxFragment" />
        <action
            android:id="@+id/action_settings_to_folders"
            app:destination="@id/folderManagementFragment" />
    </fragment>

    <fragment
        android:id="@+id/folderManagementFragment"
        android:name="com.emailclient.presentation.folders.FolderManagementFragment"
        android:label="Manage Folders"
        tools:layout="@layout/fragment_folder_management" />

    <fragment
        android:id="@+id/folderViewFragment"
        android:name="com.emailclient.presentation.folder.FolderViewFragment"
        android:label="{folderName}"
        tools:layout="@layout/fragment_folder_view">
        <argument
            android:name="folderId"
            app:argType="long" />
        <argument
            android:name="folderName"
            app:argType="string"
            android:defaultValue="Folder" />
        <action
            android:id="@+id/action_folder_to_detail"
            app:destination="@id/emailDetailFragment" />
        <action
            android:id="@+id/action_folder_to_compose"
            app:destination="@id/composeFragment" />
    </fragment>

    <action
        android:id="@+id/action_global_folder_view"
        app:destination="@id/folderViewFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="false"
        app:launchSingleTop="true" />

</navigation>
