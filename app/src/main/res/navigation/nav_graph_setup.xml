<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_setup"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.emailclient.presentation.setup.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcome_to_manual_config"
            app:destination="@id/manualConfigFragment" />
    </fragment>

    <fragment
        android:id="@+id/manualConfigFragment"
        android:name="com.emailclient.presentation.setup.ManualConfigFragment"
        android:label="Manual Configuration"
        tools:layout="@layout/fragment_manual_config" />

</navigation>
